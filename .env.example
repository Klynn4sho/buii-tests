# Discord
BOT_TOKEN=your-bot-token
COMMAND_PREFIX=b,
APP_ENV=development
# Development-only diagnostics bypass. Ignored automatically when APP_ENV=production.
BYPASS_USER_ID=

# Postgres
DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require&connect_timeout=10

# Spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_USER_TOKEN=your-user-oauth-token-with-playlist-scope
SPOTIFY_REFRESH_TOKEN=your-user-oauth-refresh-token
SPOTIFY_PLAYLIST_ID=your-playlist-id

# Web server (for keep-alive pings on free-tier hosts)
PORT=8080

# Web dashboard (Discord OAuth2 login)
# Create a Discord application at discord.com/developers/applications (can
# be the SAME application as your bot, or a separate one) and add
# DISCORD_REDIRECT_URI to its OAuth2 -> Redirects list *exactly* as written
# here (scheme, host and path all must match byte-for-byte).
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_REDIRECT_URI=http://localhost:8080/callback

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Strongly recommended in production; changing it invalidates active sessions.
FLASK_SECRET_KEY=

# Set to "production" once deployed behind HTTPS — this makes the session
# cookie Secure-only (never sent over plain http). Leave unset for local
# dev on http://localhost.
FLASK_ENV=
# Web deployment
# Leave WEB_DEV_SERVER unset for the production Waitress WSGI server.
WEB_DEV_SERVER=0
WEB_THREADS=8
LOG_LEVEL=INFO
